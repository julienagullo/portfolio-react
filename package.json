{
  "name": "portfolio-react",
  "private": true,
  "version": "1.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "compile": "tsc -b && vite build --mode compile",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate-rag-docs": "node src/scripts/generate-rag-docs.mjs",
    "generate-rag-embeddings": "node src/scripts/generate-rag-embeddings.mjs",
    "generate-rag": "npm run generate-rag-docs && npm run generate-rag-embeddings"
  },
  "dependencies": {
    "@babylonjs/core": "^9.18.1",
    "howler": "^2.2.4",
    "react": "^19.2.7",
    "react-babylonjs": "^4.0.2",
    "react-dom": "^19.2.7"
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/howler": "^2.2.13",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
